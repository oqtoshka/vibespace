# VibeSpace UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'vibespace status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   vibespace start    - Start the server
#   vibespace status   - Show configuration and data locations
#   vibespace help     - Show help information
#   vibespace version  - Show version information

# =============================================================================
# BRANDING
# =============================================================================

# Application title / brand name shown in the sidebar header, the browser tab,
# and the PWA. Build-time variable (inlined into the client bundle), so set it
# before `npm run build`. Defaults to "VibeSpace" when unset.
# VITE_APP_TITLE=VibeSpace

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# SINGLE SIGN-ON (OPENID CONNECT)
# =============================================================================
#
# Set VS_OIDC_ISSUER to authenticate against an identity provider (Authentik,
# Keycloak, Entra, …) instead of the built-in username/password. While it is
# set, /api/auth/login and /api/auth/register answer 403 — SSO replaces
# password auth rather than sitting beside it.
#
# In the multi-user manager, also set VS_MANAGER_AUTH=oidc; see
# server/manager/README.md.
#
# Authentik: create an OAuth2/OpenID provider, then copy the "OpenID
# Configuration Issuer" from the provider's page — including its trailing
# slash, which is part of the issuer identity.
# VS_OIDC_ISSUER=https://auth.example.com/application/o/vibespace/
# VS_OIDC_CLIENT_ID=...
# VS_OIDC_CLIENT_SECRET=...

# Who may sign in. Required for the single-user server: an identity provider
# usually serves more than this one application, so without it every account in
# the directory could log in. Comma-separated, matched case-insensitively.
# VS_OIDC_ALLOWED_USERS=yourname

# The redirect URI, which the provider must have registered *exactly*. Leave
# unset to derive it from the request (needs a proxy that sets X-Forwarded-*
# honestly); set it explicitly when in doubt.
# VS_OIDC_REDIRECT_URI=https://vibespace.example.com/api/auth/oidc/callback

# Which claim carries the VibeSpace username. It must look like a username —
# letters, digits, "_" and "-" — because it becomes a directory name and, in
# manager mode, the key into the user map. An email claim will be refused.
# VS_OIDC_USERNAME_CLAIM=preferred_username

# Name shown on the sign-in button ("Continue with Authentik").
# VS_OIDC_LABEL=Authentik

# VS_OIDC_SCOPES=openid profile email
# Signing out here also ends the provider's session — otherwise the next visit
# silently signs straight back in. Also signs the user out of other apps.
# VS_OIDC_END_SESSION_ON_LOGOUT=true
# 'auto' follows X-Forwarded-Proto; force with 'true'/'false'.
# VS_OIDC_COOKIE_SECURE=auto


