          "string",
          "null"
        ]
      },
      "type": {
        "enum": [
          "custom_tool_call"
        ],
        "title": "CustomToolCallResponseItemType",
        "type": "string"
      }
    },
    "required": [
      "call_id",
      "input",
      "name",
      "type"
    ],
    "title": "CustomToolCallResponseItem",
    "type": "object"
  },
